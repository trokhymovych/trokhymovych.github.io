@InProceedings{trokhymovych2023wikifactfind,
  author = {Mykola Trokhymovych and Diego Saez-Trumper},
  title = {WikiFactFind: Semi-automated fact-checking based on Wikipedia},
  booktitle = {Wiki Workshop},
  year = {2022},
  url = {https://wikiworkshop.org/2022/papers/WikiWorkshop2022_paper_21.pdf},
  selected={false},
  bibtex_show={true},
  preview={wikiworkshop.png},
  slides = {papers_slides/WikiWorkshop_22.pdf},
  poster = {papers_posters/WikiFactFind_poster.pdf},
  abstract = {Fact verification has become an essential task, being used in various areas from checking auto-generated content to fighting disinformation in hybrid wars. However, even though there has been relevant advances in creating automatic fact-checking systems, nowadays manual work is crucial to deliver good quality results. The manual fact verification usually consists of information retrieval, and logical reasoning for making the final verdict. In this work we concentrate on the process of searching for the fact proofs, reveal possible problems while searching, and propose a tool that helps increase the speed of fact checking without sacrificing its quality.},
  keywords = {evidence retrieval, information retrieval, automated fact checking, Wikipedia, fact verification, NLP},
  pdf = {https://wikiworkshop.org/2022/papers/WikiWorkshop2022_paper_21.pdf}
}

